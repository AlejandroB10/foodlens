# FoodLens Backend — environment variables
# Copy this file to backend/.env and fill in any values you want to override.
# No secrets are needed for this project — all defaults work out of the box.

# Open Food Facts API
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2
OFF_USER_AGENT=FoodLens-Backend/0.1 (team@uib.cat)
OFF_TIMEOUT_SECONDS=3

# Response cache (in-process TTL, seconds)
CACHE_TTL_SECONDS=60

# Token bucket rate limits (requests per minute, enforced per endpoint)
RATE_SEARCH_PER_MIN=10
RATE_PRODUCT_PER_MIN=100

# Index file path (relative to repo root or absolute)
ALT_INDEX_PATH=backend/data/alt_index.pkl

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
BACKEND_LOG_LEVEL=INFO
