.pnpm-store/

# Build artifacts (we currently have none, but pre-emptive)
dist/
build/
*.tsbuildinfo

# Open Food Facts data dumps (multi-GB, never commit)
data/*.csv
data/*.csv.gz
data/*.parquet
data/*.duckdb

# Trained models (regenerate with scripts/train_nutriscore_rf.py, never commit)
*.pkl
*.joblib
*.h5
backend/models/

# Backend KNN index — rebuild with scripts/build_knn_index.py; never commit
backend/data/*.pkl

# Test suites — kept out of commits for now (revisit in the future).
# These directories live on disk locally; do not delete them.
backend/tests/
frontend/tests/

# Logs and temporary
*.log
tmp/
.tmp/

# Telemetry data (F-45) — user event log, never commit
*.jsonl

# Local agent artefacts (Claude Code, Cursor caches, etc.)
.claude/
.cursor/
.aider*

# Local IDE / agent-harness tooling (per-developer, not project-wide).
# These hold each contributor's local agent setup; never commit.
.atl/
.pi/

# Playwright run artefacts — never commit
test-results/

# QA harness output and configs (Playwright runner + recorder) — never commit
.finalrun/
qa-output/
playwright.config.js
qa_video_recorder.js
