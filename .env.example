# FoodLens — repo-root .env.example (docker-compose subset)
# Copy to .env and adjust for local docker-compose usage.
# No secrets are needed for this project.

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2
OFF_USER_AGENT=FoodLens-Backend/0.1 (team@uib.cat)

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Frontend (nginx container)
FRONTEND_PORT=8080

# Logging
BACKEND_LOG_LEVEL=INFO

# KNN index (read-only mounted at /app/backend/data inside the container)
ALT_INDEX_PATH=backend/data/alt_index.pkl
