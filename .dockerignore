# .dockerignore — repo root
# Excludes files from the docker build context sent to the daemon.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
*.coverage

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore

# Secrets / local overrides — never bake into images
.env
backend/.env
*.env

# The pickle index is mounted at runtime, not baked in.
backend/data/*.pkl

# Docs and notebooks — not needed at runtime
docs/
notebooks/

# Frontend build artefacts (none in this project, but guard anyway)
node_modules/
